# Copy to .env and adjust. Never commit .env or real credentials.

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=true

# --- Infrastructure (docker-compose overrides DATABASE_URL/REDIS_URL inside containers)
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:55432/marketplace
REDIS_URL=redis://localhost:56379/0

# --- URLs / CORS ---------------------------------------------------------------
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# --- Authentication --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-development-only-secret-key-32b
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false                # must be true in production
COOKIE_DOMAIN=
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Uploads ---------------------------------------------------------------------
UPLOAD_DIR=var/uploads
UPLOAD_MAX_BYTES=5242880

# --- Checkout --------------------------------------------------------------------
INVENTORY_RESERVATION_MINUTES=30
RUN_MAINTENANCE_LOOP=true

# --- Payments --------------------------------------------------------------------
# mock: simulated provider, no real money (refused in production).
# moyasar: requires an approved Moyasar for Platforms account. See docs/architecture/moyasar-verification.md
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret-development-only
MOCK_AUTO_ACTIVATE_MERCHANTS=true

MOYASAR_LIVE=false
MOYASAR_API_BASE=https://api.moyasar.com/v1
MOYASAR_PLATFORM_API_BASE=https://apimig.moyasar.com/v1
MOYASAR_SECRET_KEY=
MOYASAR_PLATFORM_API_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_PLATFORM_WEBHOOK_SECRET=
MOYASAR_PLATFORM_RECIPIENT_ID=
# Only after Moyasar enables splitting for this platform:
MOYASAR_SPLITS_ENABLED=false
MOYASAR_ENABLED_SCHEMES=["mada","visa","master"]
# Fee schedule agreed with Moyasar (JSON), e.g.
# {"tax_inclusive":true,"mada_charge_rate":1.7,"mada_charge_fixed":1.0,"mada_refund_fixed":1.0,"cc_charge_rate":2.7,"cc_charge_fixed":1.0,"cc_refund_fixed":1.0}
MOYASAR_MERCHANT_FEES=

# --- Transactional email (optional; when unset emails are only logged) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
