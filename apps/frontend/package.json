{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:e2e",
		"api:types": "openapi-typescript ${API_SCHEMA_URL:-http://localhost:8000/api/openapi.json} -o src/lib/api/schema.d.ts",
		"pwa:assets": "pwa-assets-generator"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.70.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-scale": "^4.0.9",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24",
		"@unplugin-pwa/core": "0.0.4",
		"@vite-pwa/assets-generator": "2.0.0",
		"@vite-pwa/sveltekit": "2.0.1",
		"@vite-pwa/workbox-swkit": "8.0.14",
		"@vite-pwa/workbox-window": "8.0.14",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"layerchart": "^2.9.2",
		"magicast": "^0.5.5",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "1.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/ibm-plex-sans-arabic": "^5.3.0",
		"chart.js": "^4.6.1",
		"leaflet": "1.9.4",
		"openapi-fetch": "^0.17.0"
	}
}
